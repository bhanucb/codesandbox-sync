{
  "defaults": {
    "r2": {
      "bucket": "project-zips",
      "accountId": "REPLACE_WITH_YOUR_ACCOUNT_ID",
      "accessKeyId": "REPLACE_WITH_YOUR_R2_ACCESS_KEY_ID",
      "secretAccessKey": "REPLACE_WITH_YOUR_R2_SECRET"
    },
    "app": "my-app",
    "exclude": ["dist", "coverage"]
  },
  "apps": {
    "my-app": {
      "sourceDir": "/absolute/path/to/my-app",
      "downloadDir": "/absolute/path/to/my-app"
    },
    "other-app": {
      "sourceDir": "/absolute/path/to/other-app",
      "downloadDir": "/absolute/path/to/other-app-restored",
      "remotePrefix": "archive/other-app",
      "exclude": ["fixtures/large"]
    }
  }
}
