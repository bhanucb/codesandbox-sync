# --- Required ---
# CodeSandbox API token: https://codesandbox.io/t/api
# (CODESANDBOX_TOKEN is accepted as an alias)
CSB_API_KEY=

# --- Optional ---
# Fallback devbox for apps that set neither "devboxId" nor "defaults.devboxId".
# Find it in the devbox URL: https://codesandbox.io/p/devbox/<DEVBOX_ID>
DEVBOX_ID=

# Default app for `npm run …` commands when --app is omitted
# APP_NAME=my-app

# Alternate app registry (default: <repo>/apps.json)
# CSB_SYNC_CONFIG=/path/to/apps.json

# Keep node_modules (at any depth) when resetting the download directory.
# "defaults.preserveNodeModules" in apps.json takes precedence over this.
# PRESERVE_NODE_MODULES=true

# --- Legacy single-app fallback ---
# Used only when APP_NAME is set and that name is NOT in apps.json.
# All three must be present for the fallback to activate.
# SOURCE_DIR=/absolute/path/to/my-app
# REMOTE_DIR=/project/sandbox/apps/my-app
# DOWNLOAD_DIR=/absolute/path/to/my-app
