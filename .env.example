# --- Required ---
# Credentials from an R2 API token scoped to your bucket (Object Read & Write).
# Create one at: Cloudflare dashboard → R2 → API → Manage API tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket and account id may live here or in apps.json under defaults.r2.
# The account id is the hex string in your dashboard URL.
R2_BUCKET=project-zips
R2_ACCOUNT_ID=

# --- Optional ---
# Overrides the derived https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Behind a corporate proxy, set this so the S3 client routes through it.
# HTTPS_PROXY=http://proxy.corp.example:8080
# If that proxy intercepts TLS, point Node at the corporate root CA:
# NODE_EXTRA_CA_CERTS=/path/to/corp-root-ca.pem

# Default app for `npm run …` commands when --app is omitted
# APP_NAME=my-app

# Alternate app registry (default: <repo>/apps.json)
# SYNC_CONFIG=/path/to/apps.json

# Keep node_modules (at any depth) when resetting the download directory.
# "defaults.preserveNodeModules" in apps.json takes precedence over this.
# PRESERVE_NODE_MODULES=true
